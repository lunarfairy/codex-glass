<Window x:Class="CodexGlass.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Glass 控制台"
        Width="320"
        Height="242"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24">
                            <Border x:Name="Track" CornerRadius="12" Background="#305A6980" />
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFFFF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF5F8EFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="20"
            Background="#F2F8FAFE"
            BorderBrush="#CFFFFFFF"
            BorderThickness="1"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Codex Glass"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF172033" />
                    <TextBlock Text="控制悬浮条和自动启动"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="#8C364152" />
                </StackPanel>
                <Button Content="×"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="20"
                        Foreground="#80364152"
                        Click="OnCloseClick" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <Border CornerRadius="13" Background="#8FFFFFFF" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="显示悬浮条" FontSize="13" FontWeight="SemiBold" Foreground="#FF243044" />
                            <TextBlock Text="显示本周额度" Margin="0,2,0,0" FontSize="10.5" Foreground="#8C364152" />
                        </StackPanel>
                        <CheckBox x:Name="OverlayToggle"
                                  Style="{StaticResource SwitchToggle}"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="OnOverlayToggleChanged"
                                  Unchecked="OnOverlayToggleChanged" />
                    </Grid>
                </Border>

                <Border CornerRadius="13" Background="#8FFFFFFF" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自动启动" FontSize="13" FontWeight="SemiBold" Foreground="#FF243044" />
                            <TextBlock Text="随 Windows 在后台启动" Margin="0,2,0,0" FontSize="10.5" Foreground="#8C364152" />
                        </StackPanel>
                        <CheckBox x:Name="StartupToggle"
                                  Style="{StaticResource SwitchToggle}"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="OnStartupToggleChanged"
                                  Unchecked="OnStartupToggleChanged" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       FontSize="10.5"
                       Foreground="#8C364152"
                       Text="设置会立即生效" />
        </Grid>
    </Border>
</Window>
