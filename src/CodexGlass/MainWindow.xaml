<Window x:Class="CodexGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Glass"
        Width="184"
        Height="56"
        MinWidth="184"
        MaxWidth="184"
        MinHeight="56"
        MaxHeight="88"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border CornerRadius="28"
            BorderBrush="#A8FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#66FFFFFF" Offset="0" />
                <GradientStop Color="#48EDF3FA" Offset="0.55" />
                <GradientStop Color="#5CD9E4F0" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Border Margin="1"
                    CornerRadius="27"
                    BorderBrush="#75FFFFFF"
                    BorderThickness="1,1,0,0"
                    IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="W E E K"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="#7C364152"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding WeeklyPercent}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#FF172033"
                                   VerticalAlignment="Center"
                                   Typography.NumeralStyle="Lining"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <Border Height="2"
                            Margin="0,0,0,8"
                            VerticalAlignment="Bottom"
                            Background="#24334152"
                            CornerRadius="1"
                            ClipToBounds="True">
                        <Border Background="#B45F8EFF"
                                CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WeeklyProgress}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="18,0,18,8">
                    <Border Height="1"
                            VerticalAlignment="Top"
                            Background="#24334152" />
                    <TextBlock Text="{Binding WeeklyReset}"
                               FontSize="10.5"
                               FontWeight="Normal"
                               Foreground="#A63D4A5C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,3,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
