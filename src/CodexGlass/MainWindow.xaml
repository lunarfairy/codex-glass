<Window x:Class="CodexGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Glass"
        Width="280"
        Height="54"
        MinWidth="280"
        MaxWidth="280"
        MinHeight="54"
        MaxHeight="92"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        SourceInitialized="OnSourceInitialized"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border CornerRadius="18"
            Background="#C91A1C21"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="5H" FontSize="9" FontWeight="SemiBold" Foreground="#7FFFFFFF" Margin="0,3,9,0" />
                    <TextBlock Text="{Binding FiveHourPercent}" FontSize="23" FontWeight="SemiBold" Foreground="#FFF4F5F7" />
                </StackPanel>

                <Border Grid.Column="1" Height="20" Background="#24FFFFFF" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WEEK" FontSize="9" FontWeight="SemiBold" Foreground="#7FFFFFFF" Margin="0,3,9,0" />
                    <TextBlock Text="{Binding WeeklyPercent}" FontSize="23" FontWeight="SemiBold" Foreground="#FFF4F5F7" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" Background="#20FFFFFF" VerticalAlignment="Top" />
                <TextBlock Grid.Column="0" Text="{Binding FiveHourReset}" FontSize="10.5" Foreground="#A8FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding WeeklyReset}" FontSize="10.5" Foreground="#A8FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
