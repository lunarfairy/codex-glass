<Window x:Class="CodexGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Glass"
        Width="176"
        Height="52"
        MinWidth="176"
        MaxWidth="176"
        MinHeight="52"
        MaxHeight="82"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        SourceInitialized="OnSourceInitialized"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border CornerRadius="20"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D821242B" Offset="0" />
                <GradientStop Color="#D317191E" Offset="0.55" />
                <GradientStop Color="#DC111318" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Border Height="22" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Margin="1"
                    CornerRadius="19"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1,1,0,0"
                    IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="W E E K"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="#72FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding WeeklyPercent}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF7F8FA"
                                   VerticalAlignment="Center"
                                   Typography.NumeralStyle="Lining"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <Border Height="2"
                            Margin="0,0,0,7"
                            VerticalAlignment="Bottom"
                            Background="#18FFFFFF"
                            CornerRadius="1"
                            ClipToBounds="True">
                        <Border Background="#A8B9CAFF"
                                CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WeeklyProgress}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0,16,7">
                    <Border Height="1"
                            VerticalAlignment="Top"
                            Background="#18FFFFFF" />
                    <TextBlock Text="{Binding WeeklyReset}"
                               FontSize="10.5"
                               FontWeight="Normal"
                               Foreground="#A6FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,3,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
